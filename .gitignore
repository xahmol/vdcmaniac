# Local deployment config -- never commit
.env

# Original VDC Mode Mania release (Tokra/Mike, Akronyme Analogiker, 2012) --
# kept locally for reference only, not tracked. See README.md's Inspiration
# section for the CSDb release link. Anchored to repo root (leading slash)
# -- unanchored "original/" also matches assets/original/, which holds
# unrelated, actively-used title-screen source art that must stay tracked.
/original/

# Original VDC Mode Mania's own per-image bitmap/colour data (carried over
# from its sd2iec-version release) -- reference only, not used by anything
# in src/ or include/. Same CSDb link as above if ever needed again.
assets/vdcmodemania/

# Build outputs
build/
tools/sidreloc/sidreloc

# z64k emulator -- downloaded on demand by `make z64k`, not vendored
# (~5MB third-party binary jar, unlike tools/sidreloc/'s vendored source)
tools/z64k/

# Release ZIPs generated in project root
vdcmaniac_*.zip

# VICE snapshots (debugging artifacts)
*.vsf

# Prerequisites
*.d

# Python bytecode cache (tools/vdc_convert.py, tools/rle_test.py)
__pycache__/
*.pyc

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf
